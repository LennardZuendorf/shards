# --- Secrets & local config (never commit) ---
.shards/
config.toml
config.local.toml
.env
.env.*
*.secret

# --- Shards CLI derived cache / search index (disposable) ---
.shards-index/
*.shards-index
index.sqlite
index.sqlite-*

# --- Rust ---
/target/
**/*.rs.bk

# --- Testing / tooling ---
llvm-cov/
*.profraw

# --- Agent tooling caches ---
.serena/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# subagent-driven-development scratch workspace (ledger, briefs, review packages)
.superpowers/

# transient git worktrees created for isolated agent runs
.claude/worktrees/

# vibe mutable flow cursor (runtime; version state-machine.json, not this)
.agents/skills/vibe/state.json

# vibe evidence receipts (runtime verification output, not memory)
.agents/skills/vibe/evidence/

# vibe warnings relay (runtime warn-first channel; surfaced then truncated)
.agents/skills/vibe/warnings.log

# vibe inject edge-detection marker (runtime; records the cursor the last inject saw)
.vibe/last-inject
